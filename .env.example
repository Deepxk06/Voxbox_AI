# ── VoxBox AI · Environment Configuration ──────────────────────────
# Copy to .env and fill in the keys you have. Only configured providers
# appear in the UI. Backward-compatible aliases: GOOGLE_API_KEY == GEMINI_API_KEY.

# ── API keys (free tiers supported; never commit .env) ──
GEMINI_API_KEY=""
# GOOGLE_API_KEY=""            # alias for GEMINI_API_KEY
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# ── Default models ──
GEMINI_MODEL="gemini-3.6-flash"
GROQ_MODEL="groq/compound"
OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324:free"
OLLAMA_MODEL="llama3.2"
OLLAMA_HOST="http://localhost:11434"

# ── Server ──
PORT=5000
FLASK_DEBUG=false
VOXBOX_API_TOKEN=""            # if set, all API calls require X-VoxBox-Token

# ── Generation defaults ──
TEMPERATURE=0.7
MAX_TOKENS=2048

# ── Features ──
ENABLE_WEB_SEARCH=true         # DuckDuckGo retrieval for current-information questions
ENABLE_MEMORY=true              # durable per-user memory (stored in data/memory.json)
ENABLE_LOCAL_FALLBACK=true      # allow Ollama as a fallback provider when reachable

# ── Robustness ──
MAX_FALLBACKS=3
FALLBACK_BACKOFF=2.0

# ── Security / limits ──
MAX_CONTENT_LENGTH=1048576      # max JSON body size (bytes)
MAX_MESSAGE_CHARS=50000
MAX_MESSAGES=200
RATE_LIMIT_PER_MIN=0            # 0 = disabled
CORS_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"